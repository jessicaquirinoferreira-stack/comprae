rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Public read for published showcase products (max 50)
    match /produtos_vitrine/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Admin selected products
    match /produtos_selecionados_admin/{productId} {
      allow read, write: if isSignedIn();
    }

    // Server-side cache and daily usage quota (restricted from public client access)
    match /product_api_cache/{cacheKey} {
      allow read, write: if false;
    }
    match /api_usage_daily/{dateKey} {
      allow read, write: if false;
    }

    match /store_publication_versions/{versionId} {
      allow read, write: if isSignedIn();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.customer_name is string &&
                       request.resource.data.customer_phone is string;
      allow update, delete: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
